# ====================================================================
# AiMPN v2.0 - BASE MAINNET PRODUCTION ENVIRONMENT
# Solo Founder AI-Native Deployment Configuration
# ====================================================================

# 1. DEPLOYER PRIVATE KEY (Ví MetaMask có chứa ~0.06 ETH trên mạng Base Mainnet)
# WARNING: Tuyệt đối giữ bí mật Private Key này, không chia sẻ cho bất kỳ ai!
PRIVATE_KEY=0x_private_key_cua_ban_tuyet_doi_bi_mat

# 2. BASE MAINNET RPC URL (Mặc định dùng node công cộng của Base, hoặc thay bằng Alchemy/QuickNode)
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# 3. BASESCAN API KEY (Tùy chọn - Dùng để tích xanh verify code trên Explorer)
# Lấy miễn phí tại: https://basescan.org/myapikey
BASESCAN_API_KEY=your_basescan_api_key_here
